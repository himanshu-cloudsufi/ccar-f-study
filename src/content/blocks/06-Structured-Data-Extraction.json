        },
        {
          "t": "text",
          "v": ", validates output with "
        },
        {
          "t": "strong",
          "v": "JSON schemas"
        },
        {
          "t": "text",
          "v": ", maintains high accuracy, handles edge cases gracefully, and feeds downstream systems."
        }
      ]
    },
    {
      "type": "definition",

        {
          "t": "code",
          "v": "po_number"
        },
        {
          "t": "text",
          "v": " as required. The model fills in realistic-looking fake PO numbers. Fix?"
        }
      ],
      "options": [
        [
          {
            "t": "text",
            "v": "Prompt: \"never make up PO numbers\""
          }
        ],
        [
          {
            "t": "text",
            "v": "Make "
          },
          {
            "t": "code",
            "v": "po_number"
          },
          {
            "t": "text",
            "v": " nullable/optional so the model can return null when absent"
          }

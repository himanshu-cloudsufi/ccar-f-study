      "qid": "Q1",
      "prompt": [
        {
          "t": "text",
          "v": "Your extraction pipeline intermittently fails on malformed JSON: markdown fences, trailing commas, unescaped quotes. Most reliable fix?"
        }
      ],
      "options": [
        [
          {
            "t": "text",
            "v": "Post-process the text with regex cleanup before parsing"
          }
        ],
        [
          {
            "t": "text",
            "v": "Prompt: \"Respond ONLY with valid JSON, no markdown\""
          }
        ],
        [
          {
            "t": "text",
            "v": "Define an extraction tool with your JSON schema as input_schema and read the tool_use block, with tool_choice forcing tool use"

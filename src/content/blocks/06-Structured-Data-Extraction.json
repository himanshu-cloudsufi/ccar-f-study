    {
      "type": "heading",
      "level": 3,
      "spans": [
        {
          "t": "text",
          "v": "The aggregate-metrics trap"
        }
      ]
    },
    {
      "type": "paragraph",
      "spans": [
        {
          "t": "strong",
          "v": "97% overall accuracy can mask terrible performance on specific document types or fields"
        },
        {
          "t": "text",
          "v": " (e.g., 99% on invoices, 70% on handwritten receipts). Before reducing human review, "
        },
        {
          "t": "strong",
          "v": "validate accuracy segmented by document type AND by field"
        },
        {
          "t": "text",
          "v": "."
        }
      ]
    },
    {
      "type": "heading",

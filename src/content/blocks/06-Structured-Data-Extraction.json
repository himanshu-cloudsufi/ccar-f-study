          [
            {
              "t": "text",
              "v": "✅ Yes"
            }
          ]
        ],
        [
          [
            {
              "t": "text",
              "v": "Structural output error (wrong nesting, missing wrapper)"
            }
          ],
          [
            {
              "t": "text",
              "v": "✅ Yes"
            }
          ]
        ],
        [
          [
            {
              "t": "strong",
              "v": "Information absent from the source document"
            },
            {
              "t": "text",

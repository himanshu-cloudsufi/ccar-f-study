        ],
        [
          {
            "t": "text",
            "v": "Retry parsing up to five times"
          }
        ]
      ],
      "answer": 2,
      "explanation": [
        {
          "t": "text",
          "v": "tool_use with schemas eliminates syntax errors entirely — the model fills schema-validated parameters instead of free-writing JSON. A, B, D reduce but don't eliminate failures."
        }
      ]
    },
    {
      "type": "quiz",
      "qid": "Q2",
      "prompt": [

        {
          "t": "text",
          "v": "You are building a customer support resolution agent with the "
        },
        {
          "t": "strong",
          "v": "Claude Agent SDK"
        },
        {
          "t": "text",
          "v": ". It handles high-ambiguity requests (returns, billing disputes, account issues) via custom MCP tools: "
        },
        {
          "t": "code",
          "v": "get_customer"
        },
        {
          "t": "text",
          "v": ", "
        },
        {
          "t": "code",
          "v": "lookup_order"
        },
        {
          "t": "text",
          "v": ", "
        },
        {
          "t": "code",
          "v": "process_refund"
        },
        {
          "t": "text",
          "v": ", "
        },
        {
          "t": "code",
          "v": "escalate_to_human"
        },
        {
          "t": "text",
          "v": ". Target: "
        },
        {
          "t": "strong",
          "v": "80%+ first-contact resolution"
        },
        {
          "t": "text",
          "v": " while knowing when to escalate."
        }
      ]
    },
    {
      "type": "definition",
      "term": [
        {
          "t": "text",
          "v": "Primary domains"
        }
      ],

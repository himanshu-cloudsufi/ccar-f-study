      "spans": [
        {
          "t": "text",
          "v": "The two classic confusions"
        }
      ]
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "spans": [
            {
              "t": "strong",
              "v": "Grep vs Glob:"
            },
            {
              "t": "text",
              "v": " \"find files "
            },
            {
              "t": "em",
              "v": "named"
            },
            {
              "t": "text",
              "v": " X\" → Glob; \"find files "
            },
            {
              "t": "em",
              "v": "containing"
            },
            {
              "t": "text",
              "v": " X\" → Grep. Content vs path."
            }
          ],
          "marker": "none",
          "children": []
        },
        {
          "spans": [
            {
              "t": "strong",
              "v": "Edit failure fallback:"
            },
            {
              "t": "text",
              "v": " Edit requires the anchor text to be "
            },
            {
              "t": "strong",
              "v": "unique"
            },
            {
              "t": "text",
              "v": " in the file. When it isn't (repeated boilerplate, duplicated blocks), Edit fails → fall back to "
            },
            {
              "t": "strong",
              "v": "Read (full file) + Write (modified full file)"
            },
            {
              "t": "text",
              "v": "."
            }
          ],
          "marker": "none",
          "children": []
        }
      ]
    },
    {
      "type": "heading",
      "level": 3,
      "spans": [
        {
          "t": "text",
          "v": "Exploration strategy for unfamiliar codebases"
        }
      ]
    },
    {
      "type": "paragraph",
      "spans": [
        {
          "t": "text",
          "v": "Build understanding "
        },
        {
          "t": "strong",
          "v": "incrementally"
        },
        {
          "t": "text",
          "v": ": Grep for entry points → Read to follow imports and trace flows. "
        },
        {
          "t": "strong",
          "v": "Do not read every file upfront"
        },
        {
          "t": "text",
          "v": " (burns context, dilutes attention)."
        }
      ]
    },
    {
      "type": "definition",
      "term": [
        {
          "t": "text",
          "v": "Wrapper-module tracing pattern"
        }
      ],
      "spans": [
        {
          "t": "text",
          "v": "to trace usage of functions re-exported through wrapper modules — first identify "
        },
        {
          "t": "strong",
          "v": "all exported names"
        },
        {
          "t": "text",
          "v": ", then Grep for "
        },
        {
          "t": "strong",
          "v": "each name"
        },
        {
          "t": "text",
          "v": " across the codebase (searching only the original name misses aliased re-exports)."
        }
      ]
    },
    {
      "type": "divider"
    },

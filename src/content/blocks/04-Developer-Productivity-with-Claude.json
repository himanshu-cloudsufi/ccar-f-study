      ]
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "spans": [
            {
              "t": "code",
              "v": "--resume <session-name>"
            },
            {
              "t": "text",
              "v": " — continue a named investigation across work sessions."
            }
          ],
          "marker": "none",
          "children": []
        },
        {
          "spans": [
            {
              "t": "code",
              "v": "fork_session"
            },
            {
              "t": "text",
              "v": " — parallel exploration branches from a "
            },
            {
              "t": "strong",
              "v": "shared analysis baseline"
            },
            {
              "t": "text",
              "v": ": e.g., compare two testing strategies or two refactoring approaches without repeating the expensive codebase analysis."
            }
          ],
          "marker": "none",
          "children": []
        },
        {
          "spans": [
            {
              "t": "strong",
              "v": "Resume vs fresh:"
            }
          ],
          "marker": "none",
          "children": [
            {
              "spans": [
                {
                  "t": "text",
                  "v": "Prior context mostly valid → resume; if specific files changed, "
                },
                {
                  "t": "strong",
                  "v": "inform the agent which files"
                },
                {
                  "t": "text",
                  "v": " for targeted re-analysis."
                }
              ],
              "marker": "none",
              "children": []
            },
            {
              "spans": [
                {
                  "t": "text",
                  "v": "Prior tool results stale (big refactor landed) → "
                },
                {
                  "t": "strong",
                  "v": "new session + structured summary injected"
                },
                {
                  "t": "text",
                  "v": ". Resuming over stale file contents produces unreliable reasoning."
                }
              ],
              "marker": "none",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "type": "divider"
    },
    {
      "type": "heading",
      "level": 2,
      "spans": [
        {
          "t": "text",
          "v": "Context Management in Large Codebases (Task Statement 5.4)"
        }
      ]
    },
    {
      "type": "heading",
      "level": 3,
      "spans": [
        {
          "t": "text",
          "v": "Symptoms of context degradation"
        }
      ]
    },
    {
      "type": "paragraph",
      "spans": [
        {
          "t": "text",
          "v": "In extended sessions the model starts giving "
        },
        {
          "t": "strong",
          "v": "inconsistent answers"
        },
        {
          "t": "text",
          "v": " and referencing "
        },
        {
          "t": "strong",
          "v": "\"typical patterns\""
        },
        {
          "t": "text",
          "v": " instead of the specific classes it discovered earlier. That's your cue to intervene."
        }
      ]
    },
    {
      "type": "heading",
      "level": 3,
      "spans": [
        {
          "t": "text",
          "v": "The four countermeasures"
        }
      ]
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "spans": [
            {
              "t": "strong",
              "v": "Subagent delegation"
            },
            {
              "t": "text",
              "v": " — spawn subagents for specific verbose questions (\"find all test files\", \"trace refund-flow dependencies\") while the main agent keeps high-level coordination. Verbose exploration output stays in the subagent's context."
            }
          ],
          "marker": "none",
          "children": []
        },
        {
          "spans": [
            {
              "t": "strong",
              "v": "Scratchpad files"
            },
            {
              "t": "text",
              "v": " — agents record key findings to files and reference them for later questions, surviving context boundaries."
            }
          ],
          "marker": "none",
          "children": []
        },
        {
          "spans": [
            {
              "t": "strong",
              "v": "Phase summarization"
            },
            {
              "t": "text",
              "v": " — summarize key findings from one exploration phase, then inject the summary into the initial context of the next phase's subagents."
            }
          ],
          "marker": "none",
          "children": []
        },
        {
          "spans": [
            {
              "t": "code",
              "v": "/compact"
            },
            {
              "t": "text",
              "v": " — reduce context usage when discovery output fills the window mid-session."
            }
          ],
          "marker": "none",
          "children": []
        }
      ]
    },
    {
      "type": "heading",
      "level": 3,
      "spans": [
        {
          "t": "text",
          "v": "Crash recovery"
        }
      ]
    },
    {
      "type": "paragraph",
      "spans": [
        {
          "t": "text",
          "v": "Design "
        },
        {
          "t": "strong",
          "v": "structured state persistence"
        },
        {
          "t": "text",
          "v": ": each agent "
        },
        {
          "t": "strong",
          "v": "exports state to a known location"
        },
        {
          "t": "text",
          "v": "; on resume the coordinator "
        },
        {
          "t": "strong",
          "v": "loads a manifest"
        },
        {
          "t": "text",
          "v": " and injects it into agent prompts. Work survives crashes without full re-exploration."
        }
      ]
    },
    {
      "type": "divider"
    },

      ]
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "spans": [
            {
              "t": "strong",
              "v": "Agent prefers built-in Grep over your capable MCP tool"
            },
            {
              "t": "text",
              "v": " → your MCP tool's "
            },
            {
              "t": "strong",
              "v": "description is too thin"
            },
            {
              "t": "text",
              "v": ". Enhance it to explain capabilities and outputs in detail. (Descriptions drive selection — same principle as Scenario 1.)"
            }
          ],
          "marker": "none",
          "children": []
        },
        {
          "spans": [
            {
              "t": "strong",
              "v": "Community vs custom servers:"
            },
            {
              "t": "text",
              "v": " prefer "
            },
            {
              "t": "strong",
              "v": "existing community MCP servers for standard integrations"
            },
            {
              "t": "text",
              "v": " (e.g., Jira); build "
            },
            {
              "t": "strong",
              "v": "custom"
            },
            {
              "t": "text",
              "v": " servers only for team-specific workflows."
            }
          ],
          "marker": "none",
          "children": []
        }

          "marker": "none",
          "children": []
        },
        {
          "spans": [
            {
              "t": "strong",
              "v": "Resources"
            },
            {
              "t": "text",
              "v": " = "
            },
            {
              "t": "strong",
              "v": "content catalogs"
            },
            {
              "t": "text",
              "v": " exposed to the agent — issue summaries, documentation hierarchies, database schemas. Purpose: give agents "
            },
            {
              "t": "strong",
              "v": "visibility into available data without exploratory tool calls"
            },
            {
              "t": "text",
              "v": " (the agent doesn't have to \"search around\" to learn what exists)."
            }
          ],
          "marker": "none",
          "children": []
        }
      ]
    },
    {
